# =============================================================================
# InternShield — environment variables
# Copy this file to `.env` and fill in your own values. Never commit a real .env.
# =============================================================================

# ---- Server ----
PORT=3000

# ---- Administrator account (used by the hidden admin sign-in) ----
# Admin access is not shown in the public UI; an admin signs in through the
# normal login form and is routed to the dashboard based on their role.
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# ---- Firebase Web App config ----
# The Firebase Web config is public by design (it ships to the browser); access
# is enforced by firestore.rules / storage.rules. This project reads the config
# from public/js/firebase-config.js. If you move it to build-time variables,
# use the VITE_-prefixed names below (only those actually required).
#
# VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
# VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
# VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
# VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
# VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID


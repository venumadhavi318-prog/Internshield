# Copy this file to .env and adjust the values.
# The server loads .env automatically on start (Node 20.12+ built-in loader).

PORT=3000

# Administrator account used by the "Admin" button / admin dashboard.
ADMIN_EMAIL=admin@internshield.local
ADMIN_PASSWORD=change-me

# Firebase: the web app config lives in public/js/firebase-config.js
# (it is public by design; access is controlled by firestore.rules/storage.rules).
